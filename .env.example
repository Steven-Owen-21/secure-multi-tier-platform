# =============================================================================
# Secure Multi-Tier Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# For local development, the default values work with docker-compose.yml.
# =============================================================================

# --- Application Settings ---
ENVIRONMENT=local                           # local | demo
LOG_LEVEL=DEBUG                             # DEBUG | INFO | WARNING | ERROR
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://platform_user:platform_local_password@localhost:5432/platform_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL_REQUIRED=false                       # true for AWS, false for local

# --- Cache (Redis) ---
REDIS_URL=redis://:redis_local_password@localhost:6379/0
REDIS_SSL_ENABLED=false                     # true for AWS ElastiCache, false for local
REDIS_SESSION_TTL=3600                      # Session TTL in seconds (default: 1 hour)
REDIS_CACHE_DEFAULT_TTL=300                 # Default query cache TTL in seconds

# --- AWS / LocalStack ---
AWS_ENDPOINT_URL=http://localhost:4566      # Remove for real AWS
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test                      # Use IAM roles in AWS
AWS_SECRET_ACCESS_KEY=test                  # Use IAM roles in AWS

# --- Cognito Authentication ---
COGNITO_USER_POOL_ID=local_user_pool
COGNITO_CLIENT_ID=local_client_id
COGNITO_REGION=eu-west-2
COGNITO_JWKS_URL=http://localhost:4566/eu-west-2_local/.well-known/jwks.json

# --- Secrets Manager ---
SECRETS_DB_ARN=arn:aws:secretsmanager:eu-west-2:000000000000:secret:platform/db-credentials
SECRETS_REDIS_ARN=arn:aws:secretsmanager:eu-west-2:000000000000:secret:platform/redis-credentials
SECRETS_CACHE_TTL=86400                     # Credential cache TTL in seconds (default: 24h)

# --- SNS Notifications ---
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:platform-alerts

# --- KMS ---
KMS_KEY_ARN=arn:aws:kms:eu-west-2:000000000000:key/local-key-id

# --- S3 ---
S3_STATIC_BUCKET=platform-static-assets
S3_WAF_LOGS_BUCKET=platform-waf-logs
S3_FLOW_LOGS_BUCKET=platform-flow-logs

# --- API Gateway ---
API_GATEWAY_STAGE=development               # development | staging | production

# --- CloudFront ---
CLOUDFRONT_DISTRIBUTION_ID=local-distribution

# --- Backup ---
BACKUP_VAULT_NAME=platform-backup-vault

# --- Service Quotas ---
QUOTA_ALARM_THRESHOLD_PERCENT=80
